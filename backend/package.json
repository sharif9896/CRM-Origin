{
  "name": "react-crm-backend",
  "version": "1.0.0",
  "description": "Full Node.js/Express + MongoDB backend for the React CRM (real estate) frontend",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/seed/seed.js",
    "seed:refresh": "node src/seed/seed.js --replace",
    "seed:verify": "node src/seed/verify.js",
    "seed:destroy": "node src/seed/seed.js --destroy",
    "seed:export-json": "node src/seed/export-json.js",
    "test": "node tests/integration.cjs",
    "test:browser": "node tests/browser.cjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
