# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Optional comma-separated additional browser origins.
CLIENT_URLS=

# MongoDB
# Local:      mongodb://127.0.0.1:27017/react_crm
# Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/react_crm
MONGO_URI=mongodb://127.0.0.1:27017/react_crm

# JWT Auth
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# Email (used for forgot-password / verify-email links) - optional, only needed
# if you wire up real email sending in src/utils/sendEmail.js
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@react-crm.local

# WhatsApp Cloud API (Meta). Attempts appear as "skipped" in the admin
# delivery log until these values are configured.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v22.0
